{% extends "base.html.j2" %}
{% block title %}Receipt history{% endblock %}

{% block content %}
<div class="row">
  <div class="col-lg-12 text-center">
    <h1>Receipt history for {{ person['full_name'] }}</h1>
  </div>
</div>

<div class="row">
  <div class="col-lg-12">
    <form method="get" action="{{ url_for('persons.receipt_history', person_id=person['id']) }}" class="form-inline">
      <label for="year-filter" class="mr-2">Tax year</label>
      <input id="year-filter" class="form-control mr-2" type="number" name="year" value="{{ selected_year }}" min="2000" max="2100">
      <button class="btn btn-default mr-2" type="submit">Filter</button>
      <a href="{{ url_for('persons.receipt_history', person_id=person['id']) }}" class="btn btn-link">Clear</a>
    </form>
  </div>
</div>

<div class="row mt-3">
  <div class="col-lg-12">
    <table class="table table-striped table-bordered">
      <thead>
        <tr>
          <th>Receipt #</th>
          <th>Type</th>
          <th>Tax year</th>
          <th>Issued at</th>
          <th>Status</th>
          <th>Amount</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for receipt in receipts %}
        <tr>
          <td>{{ receipt.receipt_number }}</td>
          <td>{{ receipt.receipt_type }}</td>
          <td>{{ receipt.tax_year }}</td>
          <td>{{ receipt.issued_at }}</td>
          <td>
            {% if receipt.voided_at %}
              <span class="label label-warning">Voided</span>
            {% else %}
              <span class="label label-success">Active</span>
            {% endif %}
          </td>
          <td>{{ receipt.total_amount | currency_format }}</td>
          <td>
            <a href="{{ url_for('persons.receipt_by_id', receipt_id=receipt.id) }}" class="btn btn-info btn-sm">
              View
            </a>
            <a href="{{ url_for('persons.receipt_pdf_by_id', receipt_id=receipt.id) }}" class="btn btn-primary btn-sm">
              Download PDF
            </a>
            {% if not receipt.voided_at %}
            <form method="post" action="{{ url_for('persons.void_receipt_route', receipt_id=receipt.id) }}" style="display:inline;">
              <button type="submit" class="btn btn-warning btn-sm">Void</button>
            </form>
            <form method="post" action="{{ url_for('persons.reissue_receipt_route', receipt_id=receipt.id) }}" style="display:inline;">
              <button type="submit" class="btn btn-default btn-sm">Reissue</button>
            </form>
            {% endif %}
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="7" class="text-center">No receipts found for this filter.</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
