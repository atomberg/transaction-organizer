{% extends "base.html.j2" %}
{% block title %}Donors{% endblock %}

{% block scripts %}
<script>
  $(document).ready(function () {
    $("#donors-nav").addClass("active");
    $("#add-donor-nav").removeClass("active");
    $("#transactions-nav").removeClass("active");

    $("#table_id").DataTable({
      "stateSave": true,
      "lengthMenu": [50, 75, 100],
      "order": [],
    });
  });
</script>
{% endblock %}

{% block content %}
<div class="row">
  <div class="col-lg-12 text-center">
    <h1>Donors</h1>
    <p class="lead">Select a donor to open their family view.</p>
  </div>
</div>

<div class="row">
  <div class="col-lg-12">
    <form method="get" action="{{ url_for('donor_family.donors') }}" class="form-inline mb-3">
      <input class="form-control mr-2" type="search" name="q" value="{{ query_text }}" placeholder="Search donor">
      <button class="btn btn-default mr-2" type="submit">Filter</button>
      <a class="btn btn-link" href="{{ url_for('donor_family.donors') }}">Clear</a>
    </form>
  </div>
</div>

<div>
    <table id="table_id" class="table table-striped table-bordered" cellspacing="0" style="width:100%">
    <thead>
      <tr>
        <th>Last name</th>
        <th>First name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Donations {{ tax_year }}</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for donor in donors %}
      <tr>
        <td>{{ donor.last_name }}</td>
        <td>{{ donor.first_name }}</td>
        <td>{{ donor.email }}</td>
        <td>{{ donor.phone | phone_format }}</td>
        <td>{{ donor.donation_total | currency_format }}</td>
        <td>
          <a href="{{ url_for('donor_family.donor_get', donor_id=donor.person_id) }}" class="btn btn-info btn-sm">
            View <i class="fa fa-chevron-right"></i>
          </a>
          <a href="{{ url_for('donor_family.donor_receipt_history', donor_id=donor.person_id) }}" class="btn btn-info btn-sm">
            Receipts <i class="fa fa-chevron-right"></i>
          </a>
        </td>
      </tr>
      {% else %}
      <tr>
        <td colspan="6" class="text-center">No donors yet. Use the <strong>Add donor</strong> menu button to create the first donor.</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
