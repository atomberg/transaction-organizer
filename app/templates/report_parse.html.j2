{% extends "base.html.j2" %}
{% block title %}Parse Poynt Reports{% endblock %}

{% block taskbar %}
<div class="navbar-collapse collapse">
  <ul class="navbar-nav ml-auto">
    <li class="nav-item">
      <a class="nav-link" id="export-nav" href="#">Export</a>
    </li>
  </ul>
  <form id="report-export-form" action="{{ url_for('reports.export') }}" method="post" class="d-none">
    <input type="hidden" name="report_rows" value='{{ report_rows | tojson }}'>
  </form>
</div>
{% endblock %}

{% block scripts %}
<script type="text/javascript">
    $("#export-nav").on("click", function(event) {
      event.preventDefault();
      $("#report-export-form").trigger("submit");
    });

    $("#transactions_table").DataTable({
      "stateSave": true,
      "lengthMenu": [10, 20, 50],
      "order": [],
      "infoCallback": function( settings, start, end, max, total, pre ) {
        var api = this.api();
        var totalAmount = api.column( 3, { page: 'current' } ).data().reduce( 
          function (a, b) { return a + parseFloat(b); }, 0.0 
        );
        return 'Showing ' + start + ' to ' + end + ' of ' + total + ' entries ' + 
          '(total amount of $' + totalAmount.toFixed(2) + ')';
      }
    });
</script>
{% endblock %}

{% block content %}
<div class="row">
  <div class="col-lg-12 text-center">
    <h1>Parsed report</h1>
    <p class="lead">Here are is the aggregated data from the reports that you provided.</p>
  </div>
</div>

<div>
  <table id="transactions_table" class="table table-striped table-bordered" cellspacing="0" style="width:100%">
    <thead>
      <tr>
        <th>SKU</th>
        <th>Card</th>
        <th>Cash</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      {% for row in report_rows %}
      <tr>
        <td>{{ row.sku }}</td>
        <td>{{ row.card | currency_format }}</td>
        <td>{{ row.cash | currency_format }}</td>
        <td>{{ row.total | currency_format }}</td>
      </tr>
      {% endfor %}
    </tbody>
    <tfoot>
      <tr>
        <th>Sum</th>
        <th>{{ report_sums.card | currency_format }}</th>
        <th>{{ report_sums.cash | currency_format }}</th>
        <th>{{ report_sums.total | currency_format }}</th>
      </tr>
    </tfoot>
  </table>
</div>
{% endblock %}
