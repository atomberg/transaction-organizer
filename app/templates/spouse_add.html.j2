{% extends "base.html.j2" %}
{% block title %}Add donor{% endblock %}

{% block scripts %}
<script>
  $(document).ready(function () {
    $("#donors-nav").addClass("active");
    $("#add-donor-nav").removeClass("active");
    $("#transactions-nav").removeClass("active");
  });
</script>
{% endblock %}

{% block content %}
<div class="row">
  <div class="col-lg-12 text-center">
    <h1>Add donor</h1>
    <p class="lead">Adding to donor {{ donor['full_name'] }} (Family #{{ family['id'] }}).</p>
  </div>
</div>

<div class="row">
  <form id="add" method="post" action="{{ url_for('donor_family.add_spouse', donor_id=donor['id']) }}">
    <table id="table_id" class="table">
      <tbody>
        <tr>
          <th>Last name</th>
          <td>
            <input name="last_name" form="add" class="form-control" type="text" placeholder="Last name" value="{{ default_last_name }}" required>
          </td>
          <th>First name</th>
          <td>
            <input name="first_name" form="add" class="form-control" type="text" placeholder="First name" required>
          </td>
        </tr>
        <tr>
          <th>Email</th>
          <td>
            <input name="email" form="add" class="suppliers form-control" type="text" placeholder="Email">
          </td>
          <th>Phone number</th>
          <td><input name="phone" form="add" class="form-control" type="text" placeholder="Phone number"></td>
        </tr>
        <tr>
          <th>Address</th>
          <td colspan="3">
            <textarea class="categories form-control" rows="3" readonly>{{ shared_address }}</textarea>
          </td>
        </tr>
        <tr>
          <td></td>
          <td></td>
          <td></td>
          <td>
            <input type="submit" form="add" value="Create" class="btn btn-success">
            <a class="btn btn-secondary ml-2" href="{{ url_for('donor_family.donor_get', donor_id=donor['id']) }}">Back</a>
          </td>
        </tr>
      </tbody>
    </table>
  </form>
</div>
{% endblock %}
